      "codeSnapshot": "<!DOCTYPE html>\n<html>\n<head><title>Priority Tasks</title></head>\n<body>\n  <input id=\"what\" placeholder=\"new task\"><button onclick=\"deleteTask(this)\">Delete</button>\n  <select id=\"priority\"><option value=\"low\">low</option><option value=\"high\" selected>high</option></select>\n  <button id=\"add\">add</button>\n  <ul id=\"list\"></ul>\n  <div id=\"count\">0 tasks</div>\n  <script>\n    let tasks = [];\n    function render() {\n      const list = document.getElementById('list');\n      list.innerHTML = '';\n      tasks.forEach(function(t, i) {\n        const li = document.createElement('li');\n        li.textContent = (t.done ? '[x] ' : '[ ] ') + t.text + ' (' + t.priority + ')';\n        li.style.backgroundColor = t.priority === 'high' ? 'red' : 'lightgreen';\n        li.addEventListener('click', function() { t.done = !t.done; render(); });\n        list.appendChild(li);\n      });\n      document.getElementById('count').textContent = tasks.filter(t => !t.done).length + ' tasks done / ' + tasks.filter(t => t.done).length + ' tasks not done';\n    }\n    document.getElementById('add').addEventListener('click', function() {\n      const text = document.getElementById('what').value;\n      const priority = document.getElementById('priority').value;\n      if (text) tasks.push({ text: text, priority: priority, done: false });\n      render();\n    });\n  </script>\n</body>\n</html>"
