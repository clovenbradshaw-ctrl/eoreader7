---
 conformance/confabulation.test.js | 22 ++++++++++++++++++++++
 nul/index.js                      |  8 +++++++-
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/conformance/confabulation.test.js b/conformance/confabulation.test.js
index 201daae..26f4099 100644
--- a/conformance/confabulation.test.js
+++ b/conformance/confabulation.test.js
@@ -67,6 +67,28 @@ test("a difference that made one is", () => {
   assert.equal(record.pattern.moved, true);
 });
 
+test("an upstream gap from pattern passes through witness with its own type — never relabeled made_no_difference", () => {
+  // The relabel was real: pattern()'s typed refusals (unknown_spec here — a
+  // real one, produced by the same incomparable-specs construction the test
+  // above already uses) carry no boolean `moved`, so witness's guard
+  // swallowed them as "pattern not established", destroying type and detail.
+  // made_no_difference means "perceived, and therefore not testimony" — a
+  // substantive verdict — while the swallowed gap is a methodological
+  // refusal; the two must never share a label. witness already passed its
+  // OTHER upstream gaps through verbatim (admissible via `return bad`,
+  // isGap(figure) one line up); pattern was the sole asymmetry.
+  const a = ground({ material: quiet, draws: D, window: W });
+  const b = ground({ material: [...quiet, 9, 9, 9, 9, 9], draws: D, window: W + 1 });
+  const upstream = pattern({ before: a, after: b, material: quiet, reseeds: 16 });
+  assert.equal(upstream.gap, "unknown_spec");
+  const out = witness({ ground: keep(g0()), figure: difference(observed, g0()), pattern: upstream });
+  assert.equal(out.gap, "unknown_spec", "the real upstream gap comes through as itself");
+  assert.ok(Object.is(out, upstream), "the very object, detail intact — never a relabel");
+  // And a merely-missing pattern still gets its own honest verdict.
+  const missing = witness({ ground: keep(g0()), figure: difference(observed, g0()) });
+  assert.equal(missing.gap, "made_no_difference");
+});
+
 test("gaps are returned, never thrown — absence is the normal case", () => {
   assert.doesNotThrow(() => ground({ material: [], draws: D, window: W }));
   assert.doesNotThrow(() => ground({ material: quiet, draws: D, window: W, perturbation: "nope" }));
diff --git a/nul/index.js b/nul/index.js
index ea028ca..6bb9d24 100644
--- a/nul/index.js
+++ b/nul/index.js
@@ -1300,7 +1300,13 @@ export const witness = ({ ground: g, figure, pattern: p }) => {
   if (!g.kept) return gap("no_ground", { reason: "testimony from a ground that was never kept" });
   if (isGap(figure)) return figure;
   if (!figure || !Number.isFinite(figure.observed)) return gap("no_ground", { reason: "no figure" });
-  if (!p || typeof p.moved !== "boolean") return gap("made_no_difference", { reason: "pattern not established" });
+  if (!p || typeof p.moved !== "boolean") {
+    if (isGap(p)) {
+      return p;
+    } else {
+      return gap("made_no_difference", { reason: "pattern not established" });
+    }
+  }
   if (!p.moved) return gap("made_no_difference", { displacement: p.displacement, reseedNull: p.reseedNull });
   return Object.freeze({ ground: g, figure, pattern: p });
 };
