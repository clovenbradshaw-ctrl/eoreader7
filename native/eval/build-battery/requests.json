      "checks": [
        { "id": "communities", "what": "it has communities", "present": { "any": ["community", "communities", "subreddit", "subreddits"], "marks": ["r/"] } },
        { "id": "named", "what": "the three named communities appear", "distinct": { "any": ["bottlenose", "orca", "riverdolphins", "river dolphins"], "min": 3 } },
        { "id": "posts", "what": "it shows posts", "present": { "any": ["post", "posts", "posted"] } },
        { "id": "votes", "what": "posts carry votes", "present": { "any": ["vote", "votes", "upvote", "upvotes", "points", "score"] } },
        { "id": "comments", "what": "posts carry comments", "present": { "any": ["comment", "comments"] } },
        { "id": "many-posts", "what": "at least six separate posts (three communities, four each)", "repeats": { "any": ["vote", "votes", "upvote", "upvotes", "points", "comment", "comments"], "min": 6 } },
        { "id": "cafe", "what": "no coffee-shop content", "cafe": true }
      ]
    },
