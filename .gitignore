native/eval/the-fold/results/movies/
native/eval/the-fold/results/movie/
native/eval/the-fold/results/two-agent-stress-*/
native/eval/the-fold/results/long-stream/
native/eval/the-fold/results/pipeline-long-stream/
native/eval/the-fold/results/harness-samples-*.jsonl
native/eval/the-fold/results/**/*.log
native/eval/the-fold/results/**/*.wav
native/eval/the-fold/results/**/*.mp4
native/eval/the-fold/results/**/*.srt
native/eval/the-fold/results/**/*.vtt
native/eval/the-fold/reason-falsify/*.log
native/eval/lavar/results/*.log
native/eval/lavar/results/lp-*.projected.json
native/eval/lavar/results/lp-*.eot.jsonl
native/eval/lavar/results/*-real-log.json
native/eval/lavar/results/*-real-fold.json
native/eval/lavar/results/*-real-read.json
# Full-book CoNLL-U + reading dumps (55 MB) produced by the English eval walk.
native/eval/results/english/
# Rendered holograph/surface pages (up to 56 MB each) built by plans/*.mjs
# from the tracked sources; surface-template.html and the small demos stay.
native/the-fold/*-surface-holograph.html
native/the-fold/plans-surface.html
# Runtime logs/pids of the second proxy + fleet bridge.
proxy-*.log
heimdall-fleet*.log
.er7-fleet*.pid
.er7-fleet.peers
# The identity evals' run outputs (2026-09-28): the same rule as above —
# the *-RESULTS.md write-ups are the findings and stay tracked; the raw
# per-run JSON regenerates from the driver and is not read by any test.
# occupancy-host-eval.mjs reads the previous run's JSON for one control
# through an existsSync guard, so a fresh clone runs without it.
native/eval/identity/results/*.json
native/eval/identity/results-*.json
__pycache__/

# tesseract.js's own downloaded OCR model (visual-checkpoint.mjs, ~5 MB) —
# fetched on first use, same category as every other regenerable runtime
# artifact above, never committed.
native/eng.traineddata

# Per-invocation debug snapshots from the podcast-app-codegen pipeline and
# the coherence-gate falsification driver: the FULL raw model prompt/
# response for one run, written for a human to inspect after the fact,
# never read back by any downstream code (checked directly — grep finds
# only the writer in podcast-app-codegen.mjs and podcast-falsify.test.mjs,
# no reader anywhere). Not the pipeline's own regenerable OUTPUT the way
# results/*.md write-ups are (those are findings, deliberately kept
# tracked per this file's own standing rule above) — this is closer to a
# log file, and it was producing "suspiciously high line additions" on
# every unrelated commit that happened to touch the same generator.
native/the-fold/surface/podcast-app-codegen-evidence.json
native/the-fold/surface/podcast-app-improve-evidence.json
native/adapters/build/podcast-falsify-evidence.json
